NODE_ENV=development
PORT=3001
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/DBNAME?sslmode=require&sslaccept=strict"
# When switching To AWS RDS use following url
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/DBNAME?sslmode=require&sslrootcert=certs/global-bundle.pem"
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=debug

KAFKA_ENABLED=true
KAFKA_CA_PATH=./certs/aiven-ca.pem
KAFKA_CLIENT_ID=pickandorder-product-service
KAFKA_BROKERS=your-aiven-host:your-port
KAFKA_USERNAME=your-service-user
KAFKA_PASSWORD=your-service-password
KAFKA_PRODUCT_TOPIC=product.events
